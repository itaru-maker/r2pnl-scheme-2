|def 'if-do (cond then else) (
   |exec |if cond
      then
      else;
);

|def 'loop (limit now block) (
   |if-do |= limit now
      (|noop;)
      (|exec block; |loop limit |+ now 1 block;)
   ;
);

{!なぜかこっちは可能
|def 'loop (limit now block) (
   |exec |if |= limit now
      (|noop;)
      (|exec block; |loop limit |+ now 1 block;)
   ;
);
}

|loop 10 0 (|write "hello";);