!適当な
|write |pack 3  1 2 3;
|newline;

|write |null-block? ();
|newline;

|write |cons 89 ();
|newline;


|let 'augend 129837;
|let 'addend 129873;
|exec |if #true
  |pack 7 '| display '| + augend addend ';
  (noop;)
;
|newline;

|write |pack 7 '| display '| + augend addend ';;
|newline;
|write (| display | + augend addend ;);
|newline;


