|drop "これでチューリング完全っていえたりするのかな";

|let 'factorial-raw
   |func (i total) (
      |exec
         |if |= i 1
            (total;)
            (|factorial-raw |- i 1 |* total i;);
);


|drop "|v-20はストッパーなのでお気になさらず"
|let 'factorial
   |func (i) (
      |exec |if |= i 1 
               (1;)
               (|factorial-raw i 1;);
);

|display |factorial 5;
|display "<-けっか";

|newline;

|drop "orの再発明";
|drop "そろそろコメント用意したほうがいい";

|let 'or
   |func (a b) (
      |exec
         |if a
            (#true;)
            (|exec |if b
                (#true;)
                (#false;);
            );
);

|let 'or?
   |func (x y) (
      |write x;
      |display " or ";
      |write y;
      |display " は、";
      |write |or x y;
      |newline;
);

|newline;
|or? #true #true;
|or? #false #false;
|or? #true #false;
|or? #false #true;

|write |= display display;