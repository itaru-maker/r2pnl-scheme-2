!! blockをデータ構造としても使えるようにする

|let 'list50-on
  ((a i u e o)
  (ka ki ku ke ko)
   (sa shi su se so)
   (ta chi tsu te to)
   (na ni nu ne no)
   (ha hi fu he ho)
   (ma mi mu me mo)
   (ya yu yo)
   (ra ri ru re ro)
   (wa wi wu we wo)
   (n))
;


|display |head |head |tail |tail |tail list50-on;
|display |head |head |tail |tail |tail |tail list50-on;
|display |head |head |tail list50-on;
|display ", hello!";
|newline;


|display |head |head |tail |tail |tail |tail |tail |tail |tail list50-on;
|display |head |head |tail |tail |tail |tail |tail |tail list50-on;
|display |head |tail |tail |tail |tail |head |tail |tail |tail |tail |tail |tail list50-on;
|display |head |tail |tail |tail |tail |head |tail |tail |tail list50-on;
|display ", hello!";
|newline;

|display |/ 3 0; !エラー
