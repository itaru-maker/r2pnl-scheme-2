|let 'cmt drop;

|def 'hello () (|display "hello!";); |cmt "これはdefのテスト";
|hello; 
|newline;

|def 'make-counter () (
   |let 'count 0;
   |func () (
      |set 'count |+ count 1;
      count;
   );
);


|let 'counter |make-counter;

|write |counter;
|newline;
|write |counter;
|newline;
|write |counter;
|newline;
|write |counter;
|newline;
|display "ここからanother";
|newline;

|let 'another |make-counter;

|write |another;
|newline;
|write |another;
|newline;
|write |another;
