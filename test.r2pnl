!昔のコードから勝手に持ち出し
|def 'loop-raw (limit now block) (
   |exec |if |= limit now
      (|noop;)
      (|exec block;
       |loop-raw limit |+ now 1 block;)
   ;
);

|def 'repeat (time block) (
   |loop-raw time 0 block;
);


let 'pi 0;!初期値
let 'count 1;

|repeat 10 (
   |set 'pi |+ pi |/ 1 count;
   |set 'pi |- pi |/ 1 count;
   |set 'count |+ count 2;
);


