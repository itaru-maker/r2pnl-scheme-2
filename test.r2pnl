!! fizzbuzzでもやってみようかな

!! mod modoki
|def 'mod-oki (a b) (
   |let 'quotient
      |int
         |div a b;
   |- a |* b quotient;
);

|def 'fizzbuzz-branch (num) (
   |exec |if |= 0 |mod-oki num 15
      (|display "fizzbuzz";)
      
      (|exec |if |= 0 |mod-oki num 5
          (|display "buzz";)
          
          (|exec |if |= 0 |mod-oki num 3
             (|display "fizz";)
             (|display num;);
          );
      );
   |newline;
);

|def 'fizzbuzz (current-num) (
   |exec |if |= 100 current-num
      (|noop;)
      (
      |fizzbuzz-branch current-num;
      |fizzbuzz |+ current-num 1;
      );
);

|fizzbuzz 1;
